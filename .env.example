# Copy to .env and fill in your own values. .env is gitignored — never commit real secrets.

# Weights & Biases API key — required only when WANDB_ENABLED=true (see notebook 03).
# Get yours from https://wandb.ai/authorize
WANDB_API_KEY=

# Opt-in flag for notebook 03's Optuna experiment tracking. Leave unset/false
# for normal poe check / nbtest runs so they don't create W&B runs.
WANDB_ENABLED=false

# W&B project name. Defaults to "diplo-mod-1" if unset.
WANDB_PROJECT=name-of-the-project-in-wandb

# W&B run name. Leave unset to auto-generate one from the run config
# (e.g. "xgboost-baseline-50trials-maxdepth8") instead of wandb's random
# fancy name (e.g. "solar-glitter-42").
WANDB_RUN_NAME=

# Which configs/*.json file notebook 03 loads for Optuna tuning. Leave unset
# to use configs/xgboost_tuning.json (the default). Point this at another
# file (e.g. xgboost_tuning_wide.json) to try a different search space
# without editing the default config or the notebook.
XGBOOST_TUNING_CONFIG=

# Which configs/*.json file notebook 04 loads for Optuna tuning. Leave unset
# to use configs/nn_training.json (the default). Point this at another file
# (e.g. nn_training_wide.json) to try a different search space without
# editing the default config or the notebook.
NN_TRAINING_CONFIG=
